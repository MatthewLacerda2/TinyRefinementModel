# Existing environment and cache folders
.env
__pycache__/
orbax_checkpoints/
runs/
venv/
.venv/

# Local scratch: working notes, launch scripts, watchdog/protocol logs. CLAUDE.md
# says aux* is local-and-gitignored, but only two names were listed here, so every
# aux_*.log and aux_*.sh a run left behind sat in `git status` forever. One rule now.
aux*

# Working plans stay local; docs/findings/ is tracked and publishable
docs/plans/

# Time-machine reconstructions (instruments/timemachine.py): worktrees + cached venvs,
# both regenerable from the run snapshot. Never commit them.
.timemachine/

# Regenerable plot outputs at repo root (plot_history.py / eval scripts).
# The canonical, dated figures we keep live in docs/findings/.
/depth_curve.png
/reasoning_analytics.png
